# CampusAssist — Web App Environment Variables
#
# Copy this file to `.env.local` (for local dev) and fill in real values from
# the Firebase Console: Project Settings > General > Your apps > SDK setup.
#
# NEVER commit `.env.local` or any file containing real credentials.
# Vite only exposes variables prefixed with VITE_ to client-side code, by design.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only present if Google Analytics is enabled on the Firebase project
VITE_FIREBASE_MEASUREMENT_ID=

# Which environment this build targets: 'development' | 'staging' | 'production'
VITE_APP_ENV=development
